# CENTRAL AGRO — MODELO DE VARIÁVEIS PRIVADAS DO RENDER
# ATENÇÃO: preencha as credenciais antes de importar este arquivo.
# NÃO envie este arquivo ao GitHub. O .gitignore já o bloqueia.
# Para Earth Engine, use a tela Central de Integrações do PesaBoi
# para gerar GEE_SERVICE_ACCOUNT_JSON_B64. Não cole o JSON puro aqui.

# Google Earth Engine / Sentinel-2
GEE_PROJECT_ID=
GEE_SERVICE_ACCOUNT_JSON_B64=

# Embrapa AgroAPI (Agritec / ClimAPI / SmartSolos)
EMBRAPA_AGROAPI_TOKEN=

# Hugging Face — endpoint de inferência de pragas
HF_PEST_ENDPOINT_URL=
HF_TOKEN=
HF_PEST_MODEL=underdogquality/yolo11s-pest-detection
